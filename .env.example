# Local-only PostgreSQL development instance.
POSTGRES_DB=casefile
POSTGRES_USER=casefile
POSTGRES_PASSWORD=casefile_local_only
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://casefile:casefile_local_only@127.0.0.1:55432/casefile

# Disposable PostgreSQL test instance. The database name must end in `_test`.
POSTGRES_TEST_DB=casefile_test
POSTGRES_TEST_USER=casefile
POSTGRES_TEST_PASSWORD=casefile_test_local_only
POSTGRES_TEST_PORT=55433
CASEFILE_TEST_DATABASE_URL=postgresql+psycopg://casefile:casefile_test_local_only@127.0.0.1:55433/casefile_test

# Generated once by scripts/bootstrap.ps1. Keep this value stable after encrypted keys exist.
CASEFILE_MASTER_KEY=

# Worker provider: openai for real model calls; fake for zero-cost local integration.
CASEFILE_PROVIDER_MODE=openai
