{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casefile.local/schemas/v1/casefile/casefile.schema.json",
  "title": "CaseFile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "casefile_id", "title", "status", "version", "brief_ref",
    "project_profile", "resolution_specs", "entities", "relationships", "locations",
    "events", "information_units", "claims", "hypotheses", "reasoning_paths", "phases",
    "constraints", "structure_locks", "content_notices", "extensions"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "casefile_id": {"type": "string", "pattern": "^case_[a-z0-9][a-z0-9_]{0,55}$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["draft", "canon", "archived"]},
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version_id", "version_no", "parent_version_id"],
      "properties": {
        "version_id": {"type": "string", "pattern": "^(?:draft|snapshot|cv)_[a-z0-9][a-z0-9_]{0,54}$"},
        "version_no": {"type": "integer", "minimum": 1},
        "parent_version_id": {
          "oneOf": [
            {"type": "string", "pattern": "^cv_[a-z0-9][a-z0-9_]{0,56}$"},
            {"type": "null"}
          ]
        }
      }
    },
    "brief_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brief_id", "version"],
      "properties": {
        "brief_id": {"type": "string", "pattern": "^brief_[a-z0-9][a-z0-9_]{0,54}$"},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "project_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_type", "target_audience", "primary_use_case", "genres",
        "target_duration_minutes", "target_participant_count", "difficulty_template",
        "collaboration_mode"
      ],
      "properties": {
        "content_type": {"type": "string", "enum": ["interactive_reasoning"]},
        "target_audience": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "primary_use_case": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "genres": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "uniqueItems": true},
        "target_duration_minutes": {"type": "integer", "minimum": 1},
        "target_participant_count": {"type": "integer", "minimum": 1},
        "difficulty_template": {"type": "string", "enum": ["easy", "medium", "hard", "custom"]},
        "collaboration_mode": {"type": "string", "enum": ["single_lead_review", "solo"]}
      }
    },
    "resolution_specs": {"type": "array", "items": {"$ref": "objects.schema.json#/$defs/ResolutionSpec"}},
    "entities": {"type": "array", "items": {"$ref": "objects.schema.json#/$defs/Entity"}},
    "relationships": {"type": "array", "items": {"$ref": "objects.schema.json#/$defs/Relationship"}},
    "locations": {"type": "array", "items": {"$ref": "objects.schema.json#/$defs/Location"}},
    "events": {"type": "array", "items": {"$ref": "objects.schema.json#/$defs/Event"}},
    "information_units": {"type": "array", "items": {"$ref": "objects.schema.json#/$defs/InformationUnit"}},
    "claims": {"type": "array", "items": {"$ref": "objects.schema.json#/$defs/Claim"}},
    "hypotheses": {"type": "array", "items": {"$ref": "objects.schema.json#/$defs/Hypothesis"}},
    "reasoning_paths": {"type": "array", "items": {"$ref": "objects.schema.json#/$defs/ReasoningPath"}},
    "phases": {"type": "array", "items": {"$ref": "objects.schema.json#/$defs/Phase"}},
    "constraints": {"type": "array", "items": {"$ref": "objects.schema.json#/$defs/Constraint"}},
    "structure_locks": {"type": "array", "items": {"$ref": "objects.schema.json#/$defs/StructureLock"}},
    "content_notices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["notice_id", "category", "severity", "description"],
        "properties": {
          "notice_id": {"type": "string", "pattern": "^notice_[a-z0-9][a-z0-9_]{0,53}$"},
          "category": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "severity": {"type": "string", "enum": ["low", "medium", "high"]},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "extensions": {"$ref": "common.schema.json#/$defs/Extensions"}
  }
}
