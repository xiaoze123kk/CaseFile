{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casefile.local/schemas/v2/novel-editor.schema.json",
  "$defs": {
    "NovelEditorChapter": {
      "title": "NovelEditorChapter",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "text": {
          "type": "string",
          "maxLength": 2000000
        }
      },
      "required": [
        "id",
        "title",
        "text"
      ]
    },
    "NovelEditorCreate": {
      "title": "NovelEditorCreate",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_key": {
          "type": "string",
          "maxLength": 160
        },
        "source_label": {
          "type": "string",
          "maxLength": 200
        },
        "draft_id": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "chapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NovelEditorChapter"
          },
          "minItems": 1,
          "maxItems": 500
        },
        "original_chapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NovelEditorChapter"
          },
          "minItems": 1,
          "maxItems": 500
        }
      },
      "required": [
        "source_key",
        "source_label",
        "draft_id",
        "title",
        "chapters",
        "original_chapters"
      ]
    },
    "NovelEditorSave": {
      "title": "NovelEditorSave",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "chapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NovelEditorChapter"
          },
          "minItems": 1,
          "maxItems": 500
        }
      },
      "required": [
        "expected_revision",
        "title",
        "chapters"
      ]
    },
    "NovelEditorAnchor": {
      "title": "NovelEditorAnchor",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "type": "string",
          "maxLength": 100
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "maxLength": 40000
        },
        "original": {
          "type": "boolean"
        }
      },
      "required": [
        "chapter_id",
        "start",
        "end",
        "text",
        "original"
      ]
    },
    "NovelEditorRequest": {
      "title": "NovelEditorRequest",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_key": {
          "type": "string",
          "maxLength": 100
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "enum": [
            "discuss",
            "rewrite",
            "polish"
          ]
        },
        "scope": {
          "enum": [
            "chapter",
            "selection",
            "chapter_rewrite"
          ]
        },
        "chapter_id": {
          "type": "string",
          "maxLength": 100
        },
        "instruction": {
          "type": "string",
          "maxLength": 6000
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/NovelEditorAnchor"
            },
            {
              "type": "null"
            }
          ]
        },
        "requirements": {
          "anyOf": [
            {
              "$ref": "#/$defs/NovelRewriteRequirements"
            },
            {
              "type": "null"
            }
          ]
        },
        "history_after_exchange_id": {
          "type": "integer",
          "minimum": 0,
          "description": "本次对话的历史起点；不读取此位置及以前的对话或摘要。"
        }
      },
      "required": [
        "request_key",
        "expected_revision",
        "mode",
        "scope",
        "chapter_id",
        "instruction",
        "anchor"
      ]
    },
    "NovelEditorCandidateEdit": {
      "title": "NovelEditorCandidateEdit",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "before": {
          "type": "string",
          "maxLength": 40000
        },
        "after": {
          "type": "string",
          "maxLength": 40000
        },
        "reason": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "before",
        "after",
        "reason"
      ]
    },
    "NovelEditorCandidate": {
      "title": "NovelEditorCandidate",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string",
          "maxLength": 20000
        },
        "edits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NovelEditorCandidateEdit"
          },
          "maxItems": 30
        }
      },
      "required": [
        "message",
        "edits"
      ]
    },
    "NovelEditorEdit": {
      "title": "NovelEditorEdit",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "before": {
          "type": "string",
          "maxLength": 2000000
        },
        "after": {
          "type": "string",
          "maxLength": 2000000
        },
        "reason": {
          "type": "string",
          "maxLength": 2000
        },
        "status": {
          "enum": [
            "pending",
            "accepted",
            "rejected"
          ]
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "before",
        "after",
        "reason",
        "status"
      ]
    },
    "NovelEditorExchange": {
      "title": "NovelEditorExchange",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "task_id": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "enum": [
            "discuss",
            "rewrite",
            "polish"
          ]
        },
        "chapter_id": {
          "type": "string",
          "maxLength": 100
        },
        "instruction": {
          "type": "string",
          "maxLength": 6000
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/NovelEditorAnchor"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 20000
        },
        "status": {
          "type": "string",
          "maxLength": 30
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "edits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NovelEditorEdit"
          }
        },
        "scope": {
          "enum": [
            "chapter",
            "selection",
            "chapter_rewrite"
          ]
        },
        "requirements": {
          "anyOf": [
            {
              "$ref": "#/$defs/NovelRewriteRequirements"
            },
            {
              "type": "null"
            }
          ]
        },
        "editorial_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/NovelEditorialReview"
            },
            {
              "type": "null"
            }
          ]
        },
        "history_after_exchange_id": {
          "type": "integer",
          "minimum": 0,
          "description": "本次对话的历史起点；不读取此位置及以前的对话或摘要。"
        }
      },
      "required": [
        "id",
        "task_id",
        "revision",
        "mode",
        "chapter_id",
        "instruction",
        "anchor",
        "message",
        "status",
        "error",
        "usage",
        "edits"
      ]
    },
    "NovelEditorView": {
      "title": "NovelEditorView",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "source_key": {
          "type": "string",
          "maxLength": 160
        },
        "source_label": {
          "type": "string",
          "maxLength": 200
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "chapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NovelEditorChapter"
          },
          "minItems": 1,
          "maxItems": 500
        },
        "original_chapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NovelEditorChapter"
          },
          "minItems": 1,
          "maxItems": 500
        },
        "exchanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NovelEditorExchange"
          }
        }
      },
      "required": [
        "id",
        "source_key",
        "source_label",
        "revision",
        "title",
        "chapters",
        "original_chapters",
        "exchanges"
      ]
    },
    "NovelEditorDecision": {
      "title": "NovelEditorDecision",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "edit_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "action": {
          "enum": [
            "accept",
            "reject"
          ]
        }
      },
      "required": [
        "expected_revision",
        "edit_ids",
        "action"
      ]
    },
    "NovelEditorRestore": {
      "title": "NovelEditorRestore",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "expected_revision",
        "revision"
      ]
    },
    "NovelEditorVersion": {
      "title": "NovelEditorVersion",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "reason": {
          "type": "string",
          "maxLength": 100
        },
        "created_at": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "revision",
        "title",
        "reason",
        "created_at"
      ]
    },
    "NovelEditorSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "source_key",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "source_key": {
          "type": "string",
          "maxLength": 160
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "NovelChapterRewriteCandidate": {
      "title": "NovelChapterRewriteCandidate",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "message",
        "text",
        "reason"
      ]
    },
    "NovelEditorVersionDetail": {
      "title": "NovelEditorVersionDetail",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "previous_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "chapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NovelEditorChapter"
          }
        },
        "previous_chapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NovelEditorChapter"
          }
        }
      },
      "required": [
        "revision",
        "title",
        "previous_title",
        "chapters",
        "previous_chapters"
      ]
    },
    "NovelRewriteRequirements": {
      "title": "NovelRewriteRequirements",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preserve": {
          "type": "string",
          "maxLength": 3000
        },
        "allow_changes": {
          "type": "string",
          "maxLength": 3000
        }
      },
      "required": [
        "preserve",
        "allow_changes"
      ]
    },
    "NovelChapterReviewFinding": {
      "title": "NovelChapterReviewFinding",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "intent",
            "preservation",
            "meaning",
            "continuity"
          ]
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "major"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 1500
        },
        "source_quote": {
          "type": "string",
          "maxLength": 1000
        },
        "candidate_quote": {
          "type": "string",
          "maxLength": 1000
        },
        "suggestion": {
          "type": "string",
          "maxLength": 1500
        }
      },
      "required": [
        "category",
        "severity",
        "message",
        "source_quote",
        "candidate_quote",
        "suggestion"
      ]
    },
    "NovelChapterReviewCandidate": {
      "title": "NovelChapterReviewCandidate",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 2000
        },
        "action": {
          "enum": [
            "accept",
            "revise",
            "needs_author"
          ]
        },
        "revision_plan": {
          "type": "string",
          "maxLength": 3000
        },
        "findings": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/NovelChapterReviewFinding"
          }
        }
      },
      "required": [
        "summary",
        "action",
        "revision_plan",
        "findings"
      ]
    },
    "NovelChapterReviewReport": {
      "title": "NovelChapterReviewReport",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "round": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "review": {
          "$ref": "#/$defs/NovelChapterReviewCandidate"
        }
      },
      "required": [
        "candidate_hash",
        "round",
        "review"
      ]
    },
    "NovelEditorialReview": {
      "title": "NovelEditorialReview",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "completed",
            "incomplete",
            "revision_failed"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        },
        "candidate_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "revision_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "reports": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/NovelChapterReviewReport"
          }
        },
        "stages": {
          "type": "array",
          "maxItems": 18,
          "items": {
            "$ref": "#/$defs/NovelProseStage"
          }
        }
      },
      "required": [
        "status",
        "message",
        "candidate_hash",
        "revision_count",
        "reports"
      ]
    },
    "NovelProseStage": {
      "title": "NovelProseStage",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phase": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "incomplete"
          ]
        },
        "summary": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "phase",
        "label",
        "status",
        "summary",
        "findings",
        "candidate_hash"
      ]
    }
  }
}
