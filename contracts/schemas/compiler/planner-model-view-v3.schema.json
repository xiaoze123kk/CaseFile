{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casefile.local/schemas/v2/compiler/planner-model-view-v3.schema.json",
  "title": "PlannerModelViewV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "source", "case", "hard_constraints", "object_catalog", "planning_context"],
  "properties": {
    "schema_id": {"const": "compiler.story-planner-model-view.v3"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection_version", "planner_input_hash", "constraint_ir_hash"],
      "properties": {
        "projection_version": {"const": "compiler.story-planner-model-view-projection.v3"},
        "planner_input_hash": {"$ref": "compiler.schema.json#/$defs/Sha256Hex"},
        "constraint_ir_hash": {"$ref": "compiler.schema.json#/$defs/Sha256Hex"}
      }
    },
    "case": {"$ref": "narrative-ir.schema.json#/$defs/NarrativeCase"},
    "hard_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure", "exposure", "temporal", "resolutions"],
      "properties": {
        "structure": {"$ref": "planner-input-v2.schema.json#/$defs/StructureConstraints"},
        "exposure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["introduce_order", "precedence_edges"],
          "properties": {
            "introduce_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "precedence_edges": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["before_entry_key", "after_entry_key"],
                "properties": {
                  "before_entry_key": {"type": "string"},
                  "after_entry_key": {"type": "string"}
                }
              }
            }
          }
        },
        "temporal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["anchors"],
          "properties": {
            "anchors": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["event_ref", "rank", "comparable_time"],
                "properties": {
                  "event_ref": {"$ref": "../casefile/common.schema.json#/$defs/ObjectRef"},
                  "rank": {"type": "integer", "minimum": 1},
                  "comparable_time": {"type": "string", "minLength": 1, "maxLength": 64}
                }
              }
            }
          }
        },
        "resolutions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["terminal_exactly_once", "allowed_terminal_actions"],
          "properties": {
            "terminal_exactly_once": {
              "type": "array",
              "items": {"$ref": "../casefile/common.schema.json#/$defs/ObjectRef"},
              "uniqueItems": true
            },
            "allowed_terminal_actions": {
              "type": "array",
              "items": {"enum": ["resolve", "intentionally_unresolved"]},
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true
            }
          }
        }
      }
    },
    "object_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution_specs", "entities", "relationships", "locations", "events", "information_units", "claims", "hypotheses", "reasoning_paths", "constraints", "structure_locks"],
      "properties": {
        "resolution_specs": {"type": "array", "items": {"$ref": "#/$defs/ModelObject"}},
        "entities": {"type": "array", "items": {"$ref": "#/$defs/ModelObject"}},
        "relationships": {"type": "array", "items": {"$ref": "#/$defs/ModelObject"}},
        "locations": {"type": "array", "items": {"$ref": "#/$defs/ModelObject"}},
        "events": {"type": "array", "items": {"$ref": "#/$defs/ModelObject"}},
        "information_units": {"type": "array", "items": {"$ref": "#/$defs/ModelObject"}},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/ModelObject"}},
        "hypotheses": {"type": "array", "items": {"$ref": "#/$defs/ModelObject"}},
        "reasoning_paths": {"type": "array", "items": {"$ref": "#/$defs/ModelObject"}},
        "constraints": {"type": "array", "items": {"$ref": "#/$defs/ModelObject"}},
        "structure_locks": {"type": "array", "items": {"$ref": "#/$defs/ModelObject"}}
      }
    },
    "planning_context": {"$ref": "planner-input-v2.schema.json#/$defs/PlannerView/properties/planning_context"}
  },
  "$defs": {
    "ModelObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_ref", "value"],
      "properties": {
        "object_ref": {"$ref": "../casefile/common.schema.json#/$defs/ObjectRef"},
        "value": {}
      }
    }
  }
}
