{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casefile.local/schemas/v2/project/project.schema.json",
  "$defs": {
    "ProjectView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "profile",
        "status",
        "archived_at",
        "created_at",
        "updated_at",
        "casefile_id",
        "current_draft_id",
        "draft"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "type": "object",
          "additionalProperties": true
        },
        "status": {
          "type": "string"
        },
        "archived_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "casefile_id": {
          "type": "integer",
          "minimum": 1
        },
        "current_draft_id": {
          "type": "integer",
          "minimum": 1
        },
        "draft": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "revision",
            "schema_version",
            "status"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "title": {
              "type": "string"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "schema_version": {
              "type": "string"
            },
            "status": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
