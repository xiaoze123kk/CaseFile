{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casefile.local/schemas/v2/brief/brief-views.schema.json",
  "$defs": {
    "BriefView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brief_id",
        "public_id",
        "draft_revision",
        "content",
        "current_version_id"
      ],
      "properties": {
        "brief_id": {
          "type": "integer",
          "minimum": 1
        },
        "public_id": {
          "type": "string"
        },
        "draft_revision": {
          "type": "integer",
          "minimum": 1
        },
        "content": {
          "oneOf": [
            {
              "$ref": "brief.schema.json"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {},
              "maxProperties": 0
            }
          ]
        },
        "current_version_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "current_version_no": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "BriefVersionView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brief_version_id",
        "version_no",
        "content"
      ],
      "properties": {
        "brief_version_id": {
          "type": "integer",
          "minimum": 1
        },
        "brief_id": {
          "type": "integer",
          "minimum": 1
        },
        "public_id": {
          "type": "string"
        },
        "version_no": {
          "type": "integer",
          "minimum": 1
        },
        "content": {
          "$ref": "brief.schema.json"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "confirmed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
