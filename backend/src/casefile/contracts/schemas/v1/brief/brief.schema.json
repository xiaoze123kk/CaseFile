{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casefile.local/schemas/v1/brief/brief.schema.json",
  "title": "Brief",
  "description": "User-reviewed, target-neutral creative intent used as immutable Agent generation input.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_record_ids",
    "creative_intent",
    "reasoning_proposition",
    "resolution_mode",
    "conclusion_mode",
    "author_answer",
    "author_anchors",
    "boundary_text",
    "creative_constraints"
  ],
  "properties": {
    "source_record_ids": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "creative_intent": {"type": "string", "minLength": 1},
    "reasoning_proposition": {"type": "string", "minLength": 1},
    "resolution_mode": {
      "type": "string",
      "enum": ["author_anchored", "agent_proposed", "open"]
    },
    "conclusion_mode": {
      "type": "string",
      "enum": [
        "unique", "finite_multiple", "optimal", "probabilistic",
        "open_interpretation", "multiple_endings", "undetermined"
      ]
    },
    "author_answer": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "author_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchor_id", "statement"],
        "properties": {
          "anchor_id": {
            "type": "string",
            "pattern": "^anchor_[a-z0-9][a-z0-9_]{0,55}$"
          },
          "statement": {"type": "string", "minLength": 1}
        }
      }
    },
    "boundary_text": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "creative_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["constraint_id", "statement", "strength"],
        "properties": {
          "constraint_id": {
            "type": "string",
            "pattern": "^constraint_[a-z0-9][a-z0-9_]{0,51}$"
          },
          "statement": {"type": "string", "minLength": 1},
          "strength": {"type": "string", "enum": ["hard", "soft"]}
        }
      }
    },
    "core_selling_points": {
      "oneOf": [
        {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 500},
          "maxItems": 8
        },
        {"type": "null"}
      ]
    },
    "content_outline": {
      "oneOf": [
        {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 1000},
          "maxItems": 16
        },
        {"type": "null"}
      ]
    },
    "scope_estimate": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 1000},
        {"type": "null"}
      ]
    },
    "risk_notes": {
      "oneOf": [
        {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 500},
          "maxItems": 12
        },
        {"type": "null"}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"resolution_mode": {"const": "author_anchored"}},
        "required": ["resolution_mode"]
      },
      "then": {"properties": {"author_answer": {"type": "string", "minLength": 1}}},
      "else": {
        "properties": {
          "author_answer": {"type": "null"},
          "author_anchors": {"maxItems": 0}
        }
      }
    }
  ]
}
