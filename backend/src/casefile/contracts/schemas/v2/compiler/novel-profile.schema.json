{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casefile.local/schemas/v2/compiler/novel-profile.schema.json",
  "title": "NovelProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "structure", "allowed_presentation_modes", "exposure_policy"],
  "properties": {
    "schema_id": {"const": "compiler.novel-profile.v1"},
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "target_chapters", "target_scenes"],
      "properties": {
        "strategy": {"enum": ["three_act"]},
        "target_chapters": {"type": "integer", "minimum": 1, "maximum": 100},
        "target_scenes": {"type": "integer", "minimum": 1, "maximum": 500}
      }
    },
    "allowed_presentation_modes": {
      "type": "array",
      "items": {"enum": ["linear", "flashback", "flashforward"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "exposure_policy": {"enum": ["bound_plan", "planner_default"]}
  }
}
