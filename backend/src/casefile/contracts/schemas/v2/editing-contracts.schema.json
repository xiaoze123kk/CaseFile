{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casefile.local/schemas/v2/editing-contracts.schema.json",
  "title": "EditingContracts",
  "description": "Code-generation aggregate for the CaseFile editing loop.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "casefile", "brief", "brief_intake_candidate", "brief_intake_question_set",
    "validation_issue", "patch_candidate", "chat_public",
    "task_run", "task_event", "agent_generate_request", "agent_generate_result",
    "compiler_source_ref", "compiler_artifact_ref", "compiler_diagnostic",
    "compiler_profile_binding", "compile_input_manifest", "narrative_ir",
    "novel_profile", "planner_input", "planner_model_view", "story_plan_structural_patch",
    "constraint_first_planner", "novel_plan_candidate", "novel_plan"
  ],
  "properties": {
    "casefile": {"$ref": "casefile/casefile.schema.json"},
    "brief": {"$ref": "brief/brief.schema.json"},
    "brief_intake_candidate": {
      "$ref": "brief-intake/brief-intake.schema.json"
    },
    "brief_intake_question_set": {
      "$ref": "brief-intake/brief-intake.schema.json#/$defs/BriefIntakeQuestionSet"
    },
    "validation_issue": {"$ref": "validation/validation-issue.schema.json"},
    "patch_candidate": {"$ref": "casefile/patch-candidate.schema.json"},
    "chat_public": {"$ref": "chat/chat-public.schema.json"},
    "task_run": {"$ref": "task/task.schema.json#/$defs/TaskRun"},
    "task_event": {"$ref": "task/task.schema.json#/$defs/TaskEvent"},
    "agent_generate_request": {"$ref": "task/task.schema.json#/$defs/AgentGenerateRequest"},
    "agent_generate_result": {"$ref": "task/task.schema.json#/$defs/AgentGenerateResult"},
    "compiler_source_ref": {"$ref": "compiler/compiler.schema.json#/$defs/CompilerSourceRef"},
    "compiler_artifact_ref": {"$ref": "compiler/compiler.schema.json#/$defs/CompilerArtifactRef"},
    "compiler_diagnostic": {"$ref": "compiler/compiler.schema.json#/$defs/CompilerDiagnostic"},
    "compiler_profile_binding": {"$ref": "compiler/compiler.schema.json#/$defs/CompilerProfileBinding"},
    "compile_input_manifest": {"$ref": "compiler/compiler.schema.json#/$defs/CompileInputManifest"},
    "narrative_ir": {"$ref": "compiler/narrative-ir.schema.json"},
    "novel_profile": {"$ref": "compiler/novel-profile.schema.json"},
    "planner_input": {
      "oneOf": [
        {"$ref": "compiler/planner-input.schema.json"},
        {"$ref": "compiler/planner-input-v2.schema.json"},
        {"$ref": "compiler/planner-input-v3.schema.json"}
      ]
    },
    "planner_model_view": {
      "oneOf": [
        {"$ref": "compiler/planner-model-view-v3.schema.json"},
        {"$ref": "compiler/planner-model-view-v4.schema.json"}
      ]
    },
    "story_plan_structural_patch": {
      "$ref": "compiler/novel-plan.schema.json#/$defs/StoryPlanStructuralPatch"
    },
    "constraint_first_planner": {"$ref": "compiler/constraint-first-planner.schema.json"},
    "novel_plan_candidate": {"$ref": "compiler/novel-plan.schema.json#/$defs/NovelPlanCandidate"},
    "novel_plan": {"$ref": "compiler/novel-plan.schema.json#/$defs/NovelPlanIR"}
  }
}
