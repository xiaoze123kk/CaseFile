{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casefile.local/schemas/v2/validation/validation-issue.schema.json",
  "title": "ValidationIssue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "issue_id", "rule_id", "severity", "title", "object_refs",
    "evidence_refs", "explanation", "impact_refs", "fix_hint", "detection_type",
    "status", "validator_version", "extensions"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "issue_id": {"type": "string", "pattern": "^issue_[a-z0-9][a-z0-9_]{0,54}$"},
    "rule_id": {"$ref": "../casefile/common.schema.json#/$defs/RuleId"},
    "severity": {"type": "string", "enum": ["S0", "S1", "S2"]},
    "title": {"type": "string", "minLength": 1},
    "object_refs": {"type": "array", "minItems": 1, "items": {"$ref": "../casefile/common.schema.json#/$defs/ObjectRef"}},
    "evidence_refs": {"$ref": "../casefile/common.schema.json#/$defs/ObjectRefList"},
    "explanation": {"type": "string", "minLength": 1},
    "impact_refs": {"$ref": "../casefile/common.schema.json#/$defs/ObjectRefList"},
    "fix_hint": {"type": "string", "minLength": 1},
    "detection_type": {"type": "string", "enum": ["deterministic", "graph", "model_assisted", "manual"]},
    "status": {"type": "string", "enum": ["open", "accepted_risk", "resolved", "dismissed"]},
    "validator_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "extensions": {"$ref": "../casefile/common.schema.json#/$defs/Extensions"}
  }
}
